DATABASE_URL=postgres://postgres:postgres@localhost:5432/lememcon
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Production has two modes (see README, "Environment variables"); BETTER_AUTH_URL should be https in production (it turns on secure cookies; http is for local dev only).
# 1. Proxy (default): BETTER_AUTH_URL=https://games.lememcon.com, WEB_ORIGIN and COOKIE_DOMAIN unset,
#    Netlify VITE_API_URL unset.
# 2. Cross-origin: BETTER_AUTH_URL=https://api.lememcon.com, WEB_ORIGIN=https://games.lememcon.com,
#    COOKIE_DOMAIN=.lememcon.com, Netlify VITE_API_URL=https://api.lememcon.com.
BETTER_AUTH_URL=http://localhost:8080
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# SPA origin allowed to call the API (CORS/CSRF); leave unset to allow none.
WEB_ORIGIN=http://localhost:3000
# Session cookie parent domain in production, e.g. .lememcon.com; unset locally.
COOKIE_DOMAIN=
PORT=8080
# Cover mirror (S3-compatible), a fallback: settings an admin saves override it and
# deleting them reverts to this. Set ALL of the five below together or none: a partial
# set refuses to boot. Unsetting all of them is the rollback. Serve COVER_BASE_URL from the
# provider's default CDN domain or a host outside lememcon.com (session cookie domain).
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# COVER_BASE_URL=https://covers.example.com
# Optional https origin (no path) for non-AWS providers; unset means AWS in S3_REGION.
# S3_ENDPOINT=
